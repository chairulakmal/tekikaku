{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tekikaku",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/webhooks/*"],
  },
  "observability": {
    "enabled": true,
  },
  // The backfill cron trigger is added in weekend 3 with the tick implementation
  // (SPEC: build sequence and cut line); until then it would only fire no-ops.
  "r2_buckets": [
    {
      "binding": "INVOICE_PDFS",
      "bucket_name": "tekikaku-invoices",
    },
  ],
}
